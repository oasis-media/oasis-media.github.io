---
interface Props {
    region: string;
    title: string;
    code: string;
    class: string;
}
const { region, title, code, class: className } = Astro.props;

const normalizedTitle = title
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toUpperCase();
console.log(className)
---

<div class="articleCard">
    <div class="leftInfo">
        <p>{region}</p>
    </div>
    <h1 class="titleWrapper" >
        <div class={`titleInfo ${className}`} >
            <svg
                class="line0"
                width="100%"
                height="100%"
                viewBox="0 0 400 200"
                preserveAspectRatio="none"
                role="img"
                aria-label={normalizedTitle}
            >
                <text
                    x="0"
                    y="0"
                    font-size="400"
                    font-weight="900"
                    font-family="DrukBis"
                >
                    {normalizedTitle}
                </text>
            </svg>
        </div>
    </h1>
    <slot name="right">
        <div class="flagInfo">
            <img
                src=`https://flagcdn.com/w2560/${code.toLowerCase()}.png`
                alt=`${code}`
            />
        </div>
    </slot>
</div>
