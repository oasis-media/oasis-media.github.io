---
import MenuLayout from "../components/Menu.astro";
import Head from "../components/Head.astro";
import Top from "../components/Top.astro";
import countries from "../data/countries.json";

interface Post {
    url: string;
    frontmatter: {
        code: string;
        [key: string]: any;
    };
}

interface PostData {
    url: string;
    code: string;
    title: string;
    region: string;
}

const matches = import.meta.glob<Post>("./carte/*.md", { eager: true });
const posts = Object.values(matches);

const ids: string[] = [];
posts.forEach((post: Post) => {
    ids.push(post.frontmatter.code);
});

const matchedCountries = countries.filter((c) => ids.includes(c.alpha2Code));

const data: PostData[] = posts.map((post: Post) => {
    const country = matchedCountries.find(
        (c) => c.alpha2Code === post.frontmatter.code,
    );
    return {
        url: post.url,
        code: post.frontmatter.code,
        title: post.frontmatter.country,
        region: country?.region ?? "",
    };
});

import ArticleCard from '../components/articleCard.astro';
---

<html lang="fr">
    <head>
        <Head title="Pays" description="Explorez la vie politique de quelques pays !" />
    </head>
    <body>
        <MenuLayout />
        <div class="contentWrapper">
            <Top />
            <div class="browseWrap">
                {
                    data.map((d) => (
                        <a href={d.url}>
                            <ArticleCard region={d.region} title={d.title} code={d.code} class=""/>
                        </a>
                    ))
                }
            </div>
        </div>
        <script>
            import { stretchText } from '../assets/js/color.js';
            stretchText();
        </script>
    </body>
</html>