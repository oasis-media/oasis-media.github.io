import { cached } from "../lib/cache";
import MenuLayout from "../components/Menu.astro";
import Head from "../components/Head.astro";
import ArticleCard from "../components/articleCard.astro";
import Top from "../components/Top.astro";

import Parser from "rss-parser";

function firstParagraph(html = "") {
  console.log("ARIGATO", html.slice(html.indexOf("<p>") + 3).slice(0,2000))
  const text = html.slice(html.indexOf("<p>") + 3)
    .replace(/<[^>]+>/g, "") // strip inner tags
    .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
    .replace(/&nbsp;/g, " ")
    .replace(/&quot;/g, '"')
    .replace(/&amp;/g, "&")
    .trim();
  if (text) return text.slice(0, 600); // skip empty <p></p>
  
  return "";
}

const ID = "200287628-c-lian-chauveau";

const parser = new Parser({
  headers: { "User-Agent": "Mozilla/5.0 (oasis build)" }, // Goodreads can reject default agents
  customFields: {
    item: [
      "book_id",
      "author_name",
      "book_large_image_url",
      "book_image_url",
      "user_shelves",
    ],
  },
});

async function shelf(name: string) {
  try {
    const feed = await cached(`rss:${name}`, () => parser.parseURL(
      `https://www.goodreads.com/review/list_rss/${ID}?shelf=${name}`,
    ));

    return feed.items.map((i: any) => ({
      title: (i.title ?? "").trim(),
      author: i.author_name,
      href: `https://www.goodreads.com/book/show/${i.book_id}`,
      cover: [i.book_large_image_url, i.book_image_url].find(
        (u) => u && !u.includes("nophoto"),
      ),
    }));
  } catch {
    return []; // a broken feed shouldn't break the build
  }
}


const FEED_URL = "https://ln.ht/_/feed/~oasis";
const lnparser = new Parser({
  headers: {
    "User-Agent": "Mozilla/5.0 (oasis build)",
    Accept: "*/*",
  },
});
async function getBookmarks() {
  try {
    const feed = await cached(`rss:${FEED_URL}`, () =>
      lnparser.parseURL(FEED_URL),
    );

    return feed.items.map((i: any) => ({
      title: (i.title ?? "").trim(),
      href: i.link ?? i.guid ?? "",
      tags: i.categories ?? [],
      description: (i.contentSnippet ?? "").trim(),
      date: i.isoDate ?? i.pubDate ?? "",
    }));
  } catch (error) {
    console.error("Could not fetch Linkhut feed:", error);
    return [];
  }
}




const subparser = new Parser({
  headers: {
    "User-Agent": "Mozilla/5.0 (oasis build)",
    Accept: "*/*",
  },
  customFields: {
    item: [["description", "subtitle"]], // Substack's short subtitle
  },
});

const SUBSTACKS = ["pokepreet", "redf0undation", "thestalinera", "organicintellectual", "felikssoselo", "prometheanmarx"];

const FEED_URLS = [
  ...SUBSTACKS.map((name) => `https://${name}.substack.com/feed`)
];

async function getMixedFeed() {
  const results = await Promise.all(
    FEED_URLS.map(async (url) => {
      try {
        const feed = await cached(`rss:${url}`, () => subparser.parseURL(url));
        return feed.items.map((i: any) => ({
          source: (feed.title ?? new URL(url).hostname).trim(),
          title: (i.title ?? "").trim(),
          href: (i.link ?? i.guid ?? "").trim(),
          description: (
            i.subtitle ??
            (i.contentSnippet ?? "").slice(0, 200)
          ).trim(),
          author: i.creator ?? i.author ?? "",
          image: i.enclosure?.url ?? "",
          date: i.isoDate ?? i.pubDate ?? "",
          intro: firstParagraph(i["content:encoded"] ?? i.content),
        }));
      } catch (error) {
        console.error(`Could not fetch ${url}:`, error);
        return [];
      }
    }),
  );

  return results
    .flat()
    .sort((a, b) => (Date.parse(b.date) || 0) - (Date.parse(a.date) || 0));
}


const [reading, marxism, toRead, bookmarks, mixed] = await Promise.all([
  shelf("currently-reading"),
  shelf("marxism"),
  shelf("to-read"),
  getBookmarks(),
  getMixedFeed(),
]);

const shortmixed = mixed.slice(0,6)
const queue = toRead.slice(0, 8);

