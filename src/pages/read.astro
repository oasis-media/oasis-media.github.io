    <script>
      document.querySelectorAll<HTMLElement>(".bookmarks li").forEach((li) => {
        const shape: HTMLElement | null = li.querySelector(".shape");
        if(!shape) return;
        shape.style.backgroundImage = `url(${li.dataset.image})`;

        li.addEventListener("mouseenter", () => {
          shape.style.display = "block";
          window.addEventListener("mousemove", (e) => {
            if (shape) {
              shape.style.left = `${e.clientX }px`;
              shape.style.top = `${e.clientY - 100}px`;
            }
          });
        });

        li.addEventListener("mouseleave", () => {
          shape.style.display = "none";
        });
      })
      </script>
    <script>
      const links = [...document.querySelectorAll(".pageSummary img")];

      const headings = links
        .map((link) => {
          const id = link.ariaLabel;
          return id ? document.getElementById(id) : null;
        })
        .filter((heading): heading is HTMLElement => heading !== null);

      let activeHeading: HTMLElement | null = null;

      function updateActiveHeading() {
        // Point at which a heading becomes "current"
        const threshold = window.innerHeight * 0.25;

        let current = null;

        for (const heading of headings) {
          const rect = heading.getBoundingClientRect();

          if (rect.top <= threshold) {
            current = heading;
          } else {
            break;
          }
        }

        // Before reaching the first heading
        if (!current) {
          current = headings[0];
        }

        if (current === activeHeading) return;

        activeHeading = current;

        document.querySelectorAll(".pageSummary img").forEach((link) => {
          link.classList.remove("active");
        });

        document
          .querySelector(`[aria-label=${current.id}]`)
          ?.classList.add("active");
      }

      window.addEventListener("scroll", updateActiveHeading, {
        passive: true,
      });

      window.addEventListener("resize", updateActiveHeading);

      updateActiveHeading();
    </script>
