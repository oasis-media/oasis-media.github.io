---
import { JSDOM } from 'jsdom';
globalThis.document = new JSDOM().window.document;

import * as parliamentarch from '@parliamentarch/svg';

const attribution = new Map([
    [{id:"PCF", color: "#DD0000"}, 17],
    [{id:"PCF",color: "#cc2443"}, 71],
    [{id:"PF",color: "#00c000"}, 38],
    [{id:"PCF",color: "#ff8080"}, 66],
    [{id:"PR",color: "#e1a5e1"}, 23],
    [{id:"PCF",color: "#ff9900"}, 36],
    [{id:"PCF",color: "#ffeb00"}, 93],
    [{id:"EELV",color: "#0001b8"}, 34]
]);
const svgElement = parliamentarch.getSVGFromAttribution(attribution,
 {
   seatNumberFontSizeFactor:0,
   majorityLines:[
   {
     color:"black",
     width:1
   }
 ]
 });
const svgString = svgElement.outerHTML;
---

<div
  id="map"
></div>

<div class="parl">
    <Fragment class="parliement" set:html={svgString}/>
  </div>

<style>
  #map {
    width: 100%;
    height: 100vh;
  }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  async function init_map(){
    const countries = await fetch("/geojson/country.geojson")
      .then(response => response.json());
  
    const mapElement = document.querySelector("#map");
    if (!(mapElement instanceof HTMLElement)) return;

    const map = L.map(mapElement, {
      worldCopyJump: false,
      minZoom: 2,
      zoomControl: false,
      maxBounds: L.latLngBounds([-90, -180], [90, 180]),
      attributionControl: false
    });
  
    map.setView([20, 0], 2);
  
    const countryLayer = L.geoJSON(countries, {
  style: {
    fillColor: "#d9d5c7",
    fillOpacity: 1,
    color: "#252525",
    weight: 1,
    opacity: 1
  }
}).addTo(map);


  
    map.on("zoomend", () => {
      const zoom = map.getZoom();
      console.log("Zoom level:", zoom);
    });
  }

  init_map();
</script>


