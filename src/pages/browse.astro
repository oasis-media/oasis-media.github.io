---
import MenuLayout from "../layouts/MenuLayout.astro";
import Head from "../layouts/Head.astro";
import Top from "../layouts/Top.astro";

interface Post {
    url: string;
    frontmatter: {
        title: string;
        type: string;
        author: string;
        [key: string]: any;
    };
}

const matches = import.meta.glob<Post>("./articles/*.md", { eager: true });
const posts = Object.values(matches);
import ArticleCard from '../components/articleCard.astro';
---

<html lang="fr">
    <head>
        <Head title="Articles" description="Découvrez nos derniers articles sur la politique et la société !" />
    </head>
    <body>
        <MenuLayout />
        <div class="contentWrapper">
            <Top/>
            <div class="browseWrap">
                {
                    posts.map((post) => (
                        <a href={post.url}>
                            <ArticleCard code=Null region={post.frontmatter.type} title={post.frontmatter.title}>
                                <div class="authorInfo" slot="right">
                                    <p>{post.frontmatter.author}</p>
                                </div>
                            </ArticleCard>
                        </a>
                    ))
                }
            </div>
        </div>

        
            <script>
                import { stretchText } from '../assets/js/color.js';
                stretchText();
            </script>
    </body>
</html>
