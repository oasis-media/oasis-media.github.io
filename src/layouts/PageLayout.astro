---
import MenuLayout from "../layouts/MenuLayout.astro";
import Head from "../layouts/Head.astro";
import Top from "../layouts/Top.astro";
const { title, date, author, type } = Astro.props.frontmatter;
import { Image } from "astro:assets";

import index from ".././assets/img/index.png";
import ArticleCard from "../components/articleCard.astro";
---

<html lang="fr">
    <head>
        <Head title={title} />
    </head>
    <body>
        <MenuLayout />
        <Top />
        <div class="contentWrapper">
            <ArticleCard code="Null" region={type} title={title}>
                <div class="authorInfo" slot="right">
                    <p>{author}</p>
                </div>
            </ArticleCard>

            <div class="page">
                <article>
                    <slot />

                    <section class="endnoteWrap"></section>
                </article>
            </div>
        </div>

        <script>
            import { stretchText, endnote } from "../assets/js/color.js";
            stretchText();
            endnote();
        </script>
    </body>
</html>
